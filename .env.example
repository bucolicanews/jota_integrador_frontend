# Copie para .env.local -- nunca preencher valores reais aqui, este arquivo é versionado.

# Supabase Auth -- SÓ pra login/sessão (CLAUDE.md: "regra de ouro"). Nunca usado pra
# ler/escrever dado de domínio direto -- isso sempre passa pela API do backend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=[MASKED]

# API do backend (jota_integrador_backend)
VITE_API_URL=http://localhost:3002
